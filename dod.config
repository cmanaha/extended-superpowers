# Definition-of-Done config for this repo. Each criterion is `required` or `n/a`.
# The gate (plugins/extended-superpowers/hooks/definition-of-done.sh) runs every
# required criterion; any NO-GO fails the gate.

ci_green        = required
grooming        = required
acceptance_green = required

# This repo is markdown skills + bash; these do not apply here.
coverage  = n/a
lint      = n/a   # covered by ci_green (shellcheck/markdownlint inside ci.sh)
telemetry = n/a   # no telemetry surface in this repo
