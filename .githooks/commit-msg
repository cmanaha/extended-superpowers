#!/usr/bin/env bash
# commit-msg hook — a non-negotiable repo rule, enforced by tooling not docs:
# NO AI-generated attribution or co-authorship in commit messages.
#
# Commits in this repository are authored by humans. AI coding tools must not be
# credited as authors or co-authors. The patterns below target the attribution
# footers AI tools add (Co-Authored-By an AI, "Generated with", the robot emoji,
# anthropic noreply) — NOT the word "Claude" itself, which this project
# legitimately discusses. Generic by design: no person's name appears here.
set -euo pipefail

msg_file="$1"

if grep -qiE \
  'co-authored-by:.*(claude|anthropic|openai|gpt|copilot|gemini|cursor|\bai\b)|generated with \[?(claude|ai)|🤖|noreply@anthropic\.com|assisted by (claude|gpt|copilot|an ai)' \
  "$msg_file"; then
  echo "✗ commit blocked: AI attribution / co-authorship is not allowed here." >&2
  echo "  Remove any Co-Authored-By (AI), 'Generated with', 🤖, or AI-tool" >&2
  echo "  attribution line, then commit again." >&2
  exit 1
fi
