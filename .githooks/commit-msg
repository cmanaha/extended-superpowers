#!/usr/bin/env bash
# commit-msg hook — enforces a hard, non-negotiable repo rule:
# the author is Carlos Manzanedo Rueda, and NO AI attribution may appear in any
# commit message. This is enforced by tooling, not advisory docs, on purpose.
#
# It targets the specific attribution footers AI tools add — NOT the word
# "Claude" itself, because this project legitimately discusses Claude Code.
set -euo pipefail

msg_file="$1"

if grep -qiE \
  '^[[:space:]]*co-authored-by:|generated with \[?claude|🤖[[:space:]]*generated|noreply@anthropic\.com|assisted by (claude|gpt|copilot|an ai)' \
  "$msg_file"; then
  echo "✗ commit blocked: AI attribution is not allowed in this repository." >&2
  echo "  The author is Carlos Manzanedo Rueda. Remove any Co-Authored-By /" >&2
  echo "  'Generated with' / AI-attribution lines and commit again." >&2
  exit 1
fi
